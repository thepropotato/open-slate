{
  "name": "open-slate",
  "private": true,
  "version": "1.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "gen:brands": "node scripts/gen-brands.mjs",
    "gen:icons": "node scripts/gen-icons.mjs",
    "zip": "npm run build && cd dist && zip -qr ../open-slate.zip . && cd ..",
    "shots": "node scripts/shots.mjs",
    "icons:check": "node scripts/icons-check.mjs",
    "test": "node --import ./scripts/register.mjs scripts/selftest.mjs",
    "check": "npm run typecheck && npm run lint && npm run icons:check && npm run test",
    "store:shots": "npm run build && node scripts/store-shots.mjs",
    "marketing:shots": "npm run build && npm run gen:wallpaper && node scripts/marketing-shots.mjs",
    "marketing:promo": "node scripts/promo-tiles.mjs",
    "test:dom": "node scripts/dom-tests.mjs",
    "test:canvas": "node scripts/canvas-tests.mjs",
    "gen:wallpaper": "node scripts/gen-wallpaper.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-grid-layout": "^2.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@types/chrome": "^0.2.7",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "playwright": "^1.62.1",
    "simple-icons": "^16.28.0",
    "typescript": "~5.9",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2"
  }
}
